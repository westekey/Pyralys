# Pyralys Production Environment Template
# Copy this file to .env.production and fill in your actual values

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
POSTGRES_USER=pyralys_prod
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD_HERE
POSTGRES_DB=pyralys_production

# PostgreSQL connection URL (used by backend)
DATABASE_URL=postgresql+asyncpg://pyralys_prod:CHANGE_ME_STRONG_PASSWORD_HERE@postgres:5432/pyralys_production

# =============================================================================
# REDIS CONFIGURATION
# =============================================================================
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD_HERE
REDIS_URL=redis://:CHANGE_ME_REDIS_PASSWORD_HERE@redis:6379/0

# =============================================================================
# CELERY CONFIGURATION
# =============================================================================
CELERY_BROKER_URL=redis://:CHANGE_ME_REDIS_PASSWORD_HERE@redis:6379/0
CELERY_RESULT_BACKEND=redis://:CHANGE_ME_REDIS_PASSWORD_HERE@redis:6379/1

# =============================================================================
# JWT AUTHENTICATION
# =============================================================================
# Generate with: openssl rand -hex 32
SECRET_KEY=CHANGE_ME_GENERATE_RANDOM_SECRET_KEY
JWT_SECRET_KEY=CHANGE_ME_GENERATE_RANDOM_JWT_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# =============================================================================
# STRIPE CONFIGURATION
# =============================================================================
STRIPE_SECRET_KEY=sk_live_YOUR_STRIPE_SECRET_KEY_HERE
STRIPE_PUBLISHABLE_KEY=pk_live_YOUR_STRIPE_PUBLISHABLE_KEY_HERE
STRIPE_WEBHOOK_SECRET=whsec_YOUR_WEBHOOK_SECRET_HERE

# Stripe Price IDs (create these in your Stripe dashboard)
STRIPE_PRICE_PREMIUM=price_PREMIUM_ID_HERE
STRIPE_PRICE_PRO=price_PRO_ID_HERE
STRIPE_PRICE_ENTERPRISE=price_ENTERPRISE_ID_HERE

# =============================================================================
# OPENAI CONFIGURATION
# =============================================================================
OPENAI_API_KEY=sk-YOUR_OPENAI_API_KEY_HERE
OPENAI_MODEL=gpt-4-turbo-preview

# =============================================================================
# ANTHROPIC (CLAUDE) CONFIGURATION
# =============================================================================
ANTHROPIC_API_KEY=sk-ant-YOUR_ANTHROPIC_API_KEY_HERE

# =============================================================================
# AWS S3 CONFIGURATION (for media storage)
# =============================================================================
AWS_ACCESS_KEY_ID=YOUR_AWS_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=YOUR_AWS_SECRET_ACCESS_KEY
AWS_S3_BUCKET_NAME=pyralys-production-media
AWS_S3_REGION=us-east-1

# =============================================================================
# INSTAGRAM OAUTH
# =============================================================================
INSTAGRAM_APP_ID=YOUR_INSTAGRAM_APP_ID
INSTAGRAM_APP_SECRET=YOUR_INSTAGRAM_APP_SECRET
INSTAGRAM_REDIRECT_URI=https://yourdomain.com/api/v1/auth/instagram/callback

# =============================================================================
# SENDGRID EMAIL
# =============================================================================
SENDGRID_API_KEY=SG.YOUR_SENDGRID_API_KEY_HERE
FROM_EMAIL=noreply@yourdomain.com
FROM_NAME=Pyralys

# =============================================================================
# APPLICATION CONFIGURATION
# =============================================================================
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO

# Frontend URL (for CORS and redirects)
FRONTEND_URL=https://yourdomain.com
BACKEND_URL=https://api.yourdomain.com

# CORS allowed origins (comma-separated)
CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# =============================================================================
# NEXT.JS FRONTEND CONFIGURATION
# =============================================================================
NEXT_PUBLIC_API_URL=https://api.yourdomain.com/api/v1
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_YOUR_STRIPE_PUBLISHABLE_KEY_HERE
NEXT_PUBLIC_INSTAGRAM_APP_ID=YOUR_INSTAGRAM_APP_ID

# =============================================================================
# SECURITY & PERFORMANCE
# =============================================================================
# Rate limiting (requests per minute)
RATE_LIMIT_PER_MINUTE=60

# Max upload size (in MB)
MAX_UPLOAD_SIZE_MB=50

# =============================================================================
# MONITORING & LOGGING (optional)
# =============================================================================
SENTRY_DSN=https://YOUR_SENTRY_DSN_HERE (optional)
NEW_RELIC_LICENSE_KEY=YOUR_NEW_RELIC_KEY (optional)

# =============================================================================
# IMPORTANT SECURITY NOTES
# =============================================================================
# 1. NEVER commit this file with real values to version control
# 2. Use strong, randomly generated passwords
# 3. Rotate secrets regularly
# 4. Use environment-specific values (don't reuse dev secrets in production)
# 5. Consider using a secrets manager (AWS Secrets Manager, HashiCorp Vault, etc.)
