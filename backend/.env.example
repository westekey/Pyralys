# Application
APP_NAME=Pyralys API
APP_ENV=development
DEBUG=True
SECRET_KEY=your-secret-key-here-change-in-production

# Database
DATABASE_URL=postgresql+asyncpg://pyralys:password@localhost:5432/pyralys_dev
DATABASE_WRITE_URL=postgresql+asyncpg://pyralys:password@localhost:5432/pyralys_dev
DATABASE_READ_URL=postgresql+asyncpg://pyralys:password@localhost:5432/pyralys_dev

# Redis
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# JWT
JWT_SECRET=your-jwt-secret-key-here
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# OpenAI
OPENAI_API_KEY=sk-your-openai-api-key

# Anthropic (alternative LLM)
ANTHROPIC_API_KEY=your-anthropic-key

# AWS
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=eu-west-1
AWS_S3_BUCKET=pyralys-media-dev

# Social Media APIs
# Instagram/Facebook
FACEBOOK_APP_ID=your-facebook-app-id
FACEBOOK_APP_SECRET=your-facebook-app-secret

# TikTok
TIKTOK_CLIENT_KEY=your-tiktok-client-key
TIKTOK_CLIENT_SECRET=your-tiktok-client-secret

# Stripe
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-publishable-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret

# SendGrid
SENDGRID_API_KEY=your-sendgrid-api-key
FROM_EMAIL=noreply@pyralys.com

# Frontend
FRONTEND_URL=http://localhost:3000

# Monitoring
SENTRY_DSN=your-sentry-dsn

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:8000
